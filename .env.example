# Copy to .env (never commit .env). All backend settings use the AUDITOR_ prefix.

# --- Docker Compose ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Core ---
AUDITOR_ENV=development              # "production" disables /api/docs and requires COOKIE_SECURE=true, INLINE_JOBS=false
# AUDITOR_DATABASE_URL=postgresql+psycopg://localhost/auditor   (set by compose)
# AUDITOR_REDIS_URL=redis://localhost:6379/0                    (set by compose)
AUDITOR_INLINE_JOBS=false            # true = run audits in-process (no Redis/worker), dev only
AUDITOR_COOKIE_SECURE=false          # set true when served over HTTPS
AUDITOR_ALLOW_REGISTRATION=true
AUDITOR_SESSION_TTL_HOURS=168
# Signs login device cookies (brute-force protection). Required in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUDITOR_SECRET_KEY=

# --- Repository handling ---
AUDITOR_WORKSPACE_TTL_HOURS=24       # source copies are deleted after this
AUDITOR_MAX_UPLOAD_BYTES=52428800    # 50 MB
AUDITOR_MAX_EXTRACTED_BYTES=314572800
AUDITOR_MAX_FILES=20000
AUDITOR_MAX_ACTIVE_AUDITS_PER_USER=2       # queued + running at once
AUDITOR_MAX_AUDITS_PER_USER_PER_DAY=50

# --- Scanners ---
AUDITOR_OFFLINE=false                # true = no OSV/Trivy database lookups
# AUDITOR_SEMGREP_EXTRA_CONFIGS='["p/default"]'   # add Semgrep registry packs (needs network)
AUDITOR_TRIVY_SCANNERS=misconfig     # "vuln,misconfig" adds Trivy dependency scanning (~1.6 GB DB download)

# --- Sandboxed test execution (Docker) ---
AUDITOR_SANDBOX_ENABLED=false     # needs Docker access from the worker; read SECURITY.md before enabling
AUDITOR_SANDBOX_CPUS=1.0
AUDITOR_SANDBOX_MEMORY=1g
AUDITOR_SANDBOX_TIMEOUT_SECONDS=300
# AUDITOR_SANDBOX_RUNTIME=runsc      # gVisor, recommended in production

# --- AI (optional; nothing is sent without per-project consent) ---
AUDITOR_LLM_PROVIDER=anthropic       # anthropic | openai | none
AUDITOR_ANTHROPIC_API_KEY=
AUDITOR_ANTHROPIC_MODEL=claude-opus-5-5
AUDITOR_ANTHROPIC_EFFORT=medium
AUDITOR_OPENAI_API_KEY=
AUDITOR_OPENAI_MODEL=gpt-5
