# Production template. Copy to .env, fill every CHANGE-ME, and serve the web UI only through an
# HTTPS reverse proxy (it binds to 127.0.0.1:3000). The API refuses to start in production
# unless COOKIE_SECURE=true, INLINE_JOBS=false and SECRET_KEY is set (32+ characters).

# --- Docker Compose ---
POSTGRES_PASSWORD=CHANGE-ME-long-random-string

# --- Core ---
AUDITOR_ENV=production
AUDITOR_INLINE_JOBS=false
AUDITOR_COOKIE_SECURE=true
AUDITOR_SECRET_KEY=CHANGE-ME-run-python-c-import-secrets-print-secrets-token-urlsafe-48
# Create your accounts first, then set this to false (or keep true for open sign-up).
AUDITOR_ALLOW_REGISTRATION=false
AUDITOR_SESSION_TTL_HOURS=168

# --- Repository handling and per-user limits ---
AUDITOR_WORKSPACE_TTL_HOURS=24
AUDITOR_MAX_UPLOAD_BYTES=52428800
AUDITOR_MAX_EXTRACTED_BYTES=314572800
AUDITOR_MAX_FILES=20000
AUDITOR_MAX_ACTIVE_AUDITS_PER_USER=2
AUDITOR_MAX_AUDITS_PER_USER_PER_DAY=50

# --- Scanners ---
AUDITOR_OFFLINE=false
AUDITOR_TRIVY_SCANNERS=misconfig

# --- Sandboxed test execution: keep off unless you run a dedicated, hardened Docker host ---
AUDITOR_SANDBOX_ENABLED=false

# --- AI (optional; nothing is sent without per-project consent) ---
AUDITOR_LLM_PROVIDER=none
AUDITOR_ANTHROPIC_API_KEY=
AUDITOR_OPENAI_API_KEY=
